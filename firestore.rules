rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUid(uid) {
      return uid is string && uid.size() >= 1 && uid.size() <= 128 && uid.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidWinner(winner) {
      return winner in ['NONE', 'p1', 'p2', 'p3', 'p4', 'TEAM_0', 'TEAM_1', 'DRAW'];
    }

    function hasAllowedKeys(d) {
      return d.keys().hasOnly([
        'matchId', 'roomCode', 'status', 'hostUid', 'maxPlayers', 'fillWithBots',
        'activePlayers', 'matchSeed', 'matchPreset', 'gameMode', 'round', 'maxRounds',
        'teamMode', 'roundPhase', 'activeTurnIndex', 'activeRealm', 'players', 'warPot',
        'pendingClash', 'gambitArmed', 'prophecyTarget', 'statWins', 'bestWin', 'winner',
        'lastOutcome', 'turnStartedAt', 'createdAt', 'updatedAt'
      ]);
    }

    function canCreate(matchId) {
      let d = incoming();
      return isSignedIn()
        && isValidId(matchId)
        && hasAllowedKeys(d)
        && d.matchId == matchId
        && d.status == 'waiting'
        && d.hostUid == request.auth.uid
        && d.maxPlayers in [2, 3, 4]
        && d.players is list
        && d.players.size() == d.maxPlayers
        && d.players[0].uid == request.auth.uid
        && d.players[1].uid == null
        && (d.players.size() < 3 || d.players[2].uid == null)
        && (d.players.size() < 4 || d.players[3].uid == null)
        && d.activePlayers.size() == 1
        && d.activePlayers[0] == request.auth.uid
        && d.round == 1
        && d.winner == 'NONE'
        && d.turnStartedAt == request.time
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    function canUpdate(matchId) {
      return isSignedIn()
        && isValidId(matchId)
        && incoming().updatedAt == request.time
        && incoming().status in ['waiting', 'active', 'finished']
        && isValidWinner(incoming().winner)
        && incoming().players is list
        && incoming().players.size() == existing().players.size()
        && (
          isJoinRoomAction()
          || isRejoinActiveAction()
          || isToggleReadyAction()
          || isHostRoomManageAction()
          || isHostStartAction()
          || isGameplayAction()
          || isHostRematchAction()
          || isLeaveAction()
        );
    }

    function isSeatedUid(data, uid) {
      return (data.players[0].uid == uid)
        || (data.players[1].uid == uid)
        || (data.players.size() >= 3 && data.players[2].uid == uid)
        || (data.players.size() >= 4 && data.players[3].uid == uid);
    }

    function isParticipant(data) {
      return request.auth.uid == data.hostUid
        || (request.auth.uid in data.activePlayers)
        || isSeatedUid(data, request.auth.uid);
    }

    function seatJoinedOrUnchanged(i) {
      return (i >= existing().players.size())
        || (incoming().players[i] == existing().players[i])
        || (
          existing().players[i].uid == null
          && incoming().players[i].uid == request.auth.uid
          && incoming().players[i].isBot == false
          && incoming().players[i].away == false
          && incoming().players[i].ready == false
          && incoming().players[i].deck == existing().players[i].deck
        );
    }

    function seatReadyOwnOrUnchanged(i) {
      return (i >= existing().players.size())
        || (incoming().players[i] == existing().players[i])
        || (
          existing().players[i].uid == request.auth.uid
          && incoming().players[i].diff(existing().players[i]).affectedKeys().hasOnly(['ready'])
        );
    }

    function seatAwayOwnOrUnchanged(i) {
      return (i >= existing().players.size())
        || (incoming().players[i] == existing().players[i])
        || (
          existing().players[i].uid == request.auth.uid
          && incoming().players[i].diff(existing().players[i]).affectedKeys().hasOnly(['away'])
        );
    }

    function seatKickedOrUnchanged(i) {
      return (i >= existing().players.size())
        || (incoming().players[i] == existing().players[i])
        || (
          i > 0
          && existing().players[i].uid != null
          && incoming().players[i].uid == null
          && incoming().players[i].isBot == false
          && incoming().players[i].ready == false
          && incoming().players[i].away == false
        );
    }

    function isJoinRoomAction() {
      return existing().status == 'waiting'
        && !isSeatedUid(existing(), request.auth.uid)
        && isSeatedUid(incoming(), request.auth.uid)
        && (request.auth.uid in incoming().activePlayers)
        && incoming().activePlayers.hasAll(existing().activePlayers)
        && incoming().activePlayers.size() <= 4
        && incoming().players.size() == existing().players.size()
        && seatJoinedOrUnchanged(0)
        && seatJoinedOrUnchanged(1)
        && seatJoinedOrUnchanged(2)
        && seatJoinedOrUnchanged(3)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'players', 'activePlayers', 'updatedAt'
        ]);
    }

    function isRejoinActiveAction() {
      return existing().status == 'active'
        && isSeatedUid(existing(), request.auth.uid)
        && (request.auth.uid in incoming().activePlayers)
        && incoming().activePlayers.hasAll(existing().activePlayers)
        && incoming().players.size() == existing().players.size()
        && seatAwayOwnOrUnchanged(0)
        && seatAwayOwnOrUnchanged(1)
        && seatAwayOwnOrUnchanged(2)
        && seatAwayOwnOrUnchanged(3)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'players', 'activePlayers', 'updatedAt'
        ]);
    }

    function isToggleReadyAction() {
      return existing().status == 'waiting'
        && isSeatedUid(existing(), request.auth.uid)
        && incoming().players.size() == existing().players.size()
        && seatReadyOwnOrUnchanged(0)
        && seatReadyOwnOrUnchanged(1)
        && seatReadyOwnOrUnchanged(2)
        && seatReadyOwnOrUnchanged(3)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'players', 'updatedAt'
        ]);
    }

    function isHostRoomManageAction() {
      return existing().status == 'waiting'
        && request.auth.uid == existing().hostUid
        && incoming().players.size() == existing().players.size()
        && seatKickedOrUnchanged(0)
        && seatKickedOrUnchanged(1)
        && seatKickedOrUnchanged(2)
        && seatKickedOrUnchanged(3)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fillWithBots', 'teamMode', 'matchPreset', 'gameMode', 'maxRounds',
          'players', 'activePlayers', 'updatedAt'
        ]);
    }

    function isHostStartAction() {
      return existing().status == 'waiting'
        && request.auth.uid == existing().hostUid
        && incoming().status == 'active'
        && incoming().turnStartedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'maxPlayers', 'matchPreset', 'gameMode', 'round', 'maxRounds',
          'teamMode', 'roundPhase', 'activeTurnIndex', 'activeRealm', 'players',
          'warPot', 'pendingClash', 'gambitArmed', 'prophecyTarget', 'statWins',
          'bestWin', 'winner', 'lastOutcome', 'turnStartedAt', 'updatedAt'
        ]);
    }

    function isTurnAuthorized() {
      let turnSeat = existing().players[existing().activeTurnIndex];
      return turnSeat.uid == request.auth.uid
        || (turnSeat.isBot == true && request.auth.uid == existing().hostUid)
        || turnSeat.away == true
        || request.time > existing().turnStartedAt + duration.value(20, 's');
    }

    function isGameplayAction() {
      return existing().status == 'active'
        && existing().winner == 'NONE'
        && isParticipant(existing())
        && isTurnAuthorized()
        && incoming().activePlayers == existing().activePlayers
        && incoming().maxPlayers == existing().maxPlayers
        && incoming().fillWithBots == existing().fillWithBots
        && incoming().teamMode == existing().teamMode
        && incoming().matchPreset == existing().matchPreset
        && incoming().gameMode == existing().gameMode
        && (
          (incoming().round == existing().round
            && incoming().activeTurnIndex == existing().activeTurnIndex
            && incoming().roundPhase == existing().roundPhase)
          || incoming().turnStartedAt == request.time
        )
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'round', 'roundPhase', 'activeTurnIndex', 'activeRealm',
          'players', 'warPot', 'pendingClash', 'gambitArmed', 'prophecyTarget',
          'statWins', 'bestWin', 'winner', 'lastOutcome',
          'turnStartedAt', 'updatedAt'
        ]);
    }

    function seatLeaveOwnOrUnchanged(i) {
      return (i >= existing().players.size())
        || (incoming().players[i] == existing().players[i])
        || (
          existing().players[i].uid == request.auth.uid
          && (
            (existing().status == 'waiting' && i > 0 && incoming().players[i].uid == null && incoming().players[i].ready == false && incoming().players[i].away == false)
            || (existing().status == 'active' && incoming().players[i].diff(existing().players[i]).affectedKeys().hasOnly(['away']) && incoming().players[i].away == true)
          )
        );
    }

    function isLeaveAction() {
      return (request.auth.uid in existing().activePlayers)
        && !(request.auth.uid in incoming().activePlayers)
        && incoming().activePlayers.size() == existing().activePlayers.size() - 1
        && incoming().players.size() == existing().players.size()
        && seatLeaveOwnOrUnchanged(0)
        && seatLeaveOwnOrUnchanged(1)
        && seatLeaveOwnOrUnchanged(2)
        && seatLeaveOwnOrUnchanged(3)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'players', 'activePlayers', 'updatedAt'
        ]);
    }

    function isHostRematchAction() {
      return existing().status == 'finished'
        && request.auth.uid == existing().hostUid
        && incoming().status == 'active'
        && incoming().round == 1
        && incoming().roundPhase == 'attack'
        && (!('pendingClash' in incoming()) || incoming().pendingClash == null)
        && incoming().winner == 'NONE'
        && incoming().players.size() == existing().players.size()
        && incoming().activePlayers == existing().activePlayers
        && incoming().turnStartedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'round', 'roundPhase', 'activeTurnIndex', 'activeRealm',
          'players', 'warPot', 'pendingClash', 'gambitArmed', 'prophecyTarget',
          'statWins', 'bestWin', 'winner', 'lastOutcome',
          'turnStartedAt', 'updatedAt'
        ]);
    }

    match /matches/{matchId} {
      allow get: if isSignedIn() && isValidId(matchId) && (
        existing().status == 'waiting'
        || isParticipant(existing())
      );

      allow list: if isSignedIn() && (
        resource.data.status == 'waiting'
        || resource.data.hostUid == request.auth.uid
        || (request.auth.uid in resource.data.activePlayers)
      );

      allow create: if canCreate(matchId);

      allow update: if canUpdate(matchId);

      allow delete: if isSignedIn() && isValidId(matchId) && (
        (existing().activePlayers.size() <= 1 && (request.auth.uid in existing().activePlayers))
        || (existing().status == 'waiting' && existing().hostUid == request.auth.uid)
        || (request.time > existing().createdAt + duration.value(2, 'h') && (existing().status == 'waiting' || existing().activePlayers.size() == 0))
      );
    }
  }
}