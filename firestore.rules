rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUid(uid) {
      return uid is string && uid.size() >= 1 && uid.size() <= 128 && uid.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() == 6 && code.matches('^[A-Z0-9]{6}$');
    }

    function isValidStatus(status) {
      return status in ['waiting', 'active', 'finished'];
    }

    function isValidRealm(realm) {
      return realm in ['SKY', 'NETHER', 'SEA', 'WAR'];
    }

    function isValidStat(stat) {
      return stat in ['might', 'arcana', 'cunning', 'influence'];
    }

    function isValidSeatId(id) {
      return id in ['p1', 'p2', 'p3', 'p4'];
    }

    function isValidWinner(winner) {
      return winner in ['NONE', 'p1', 'p2', 'p3', 'p4', 'TEAM_0', 'TEAM_1', 'DRAW'];
    }

    function isValidDeck(deck) {
      return deck is list && deck.size() <= 60 && (deck.size() == 0 || (deck[0] is string && deck[0].size() <= 64));
    }

    function isValidActivePlayers(players) {
      return players is list
        && players.size() <= 4
        && (players.size() < 1 || isValidUid(players[0]))
        && (players.size() < 2 || isValidUid(players[1]))
        && (players.size() < 3 || isValidUid(players[2]))
        && (players.size() < 4 || isValidUid(players[3]));
    }

    function isValidSeatMap(seat, expectedIndex) {
      return seat is map
        && seat.keys().hasAll([
          'id', 'seatIndex', 'name', 'isBot', 'uid', 'team',
          'deck', 'resurrectionUsed', 'gambitUsed', 'eliminated',
          'away', 'ready', 'roundsWon'
        ])
        && seat.keys().hasOnly([
          'id', 'seatIndex', 'name', 'isBot', 'uid', 'team',
          'deck', 'resurrectionUsed', 'gambitUsed', 'eliminated',
          'away', 'ready', 'roundsWon'
        ])
        && isValidSeatId(seat.id)
        && seat.seatIndex == expectedIndex
        && seat.name is string && seat.name.size() >= 1 && seat.name.size() <= 64
        && seat.isBot is bool
        && (seat.uid == null || isValidUid(seat.uid))
        && seat.team in [0, 1]
        && isValidDeck(seat.deck)
        && seat.resurrectionUsed is bool
        && seat.gambitUsed is bool
        && seat.eliminated is bool
        && seat.away is bool
        && seat.ready is bool
        && seat.roundsWon is int && seat.roundsWon >= 0 && seat.roundsWon <= 200;
    }

    function isValidPlayersList(players) {
      return players is list
        && players.size() >= 2
        && players.size() <= 4
        && isValidSeatMap(players[0], 0)
        && isValidSeatMap(players[1], 1)
        && (players.size() < 3 || isValidSeatMap(players[2], 2))
        && (players.size() < 4 || isValidSeatMap(players[3], 3));
    }

    function isValidStatWins(sw) {
      return sw is map
        && sw.keys().hasAll(['might', 'arcana', 'cunning', 'influence'])
        && sw.keys().hasOnly(['might', 'arcana', 'cunning', 'influence'])
        && sw.might is int && sw.might >= 0 && sw.might <= 200
        && sw.arcana is int && sw.arcana >= 0 && sw.arcana <= 200
        && sw.cunning is int && sw.cunning >= 0 && sw.cunning <= 200
        && sw.influence is int && sw.influence >= 0 && sw.influence <= 200;
    }

    function isValidProphecyTarget(pt) {
      return pt == null || (
        pt is map
        && pt.keys().hasAll(['bySeat', 'targetSeat', 'stat', 'baseValue', 'effectiveValue'])
        && pt.keys().hasOnly(['bySeat', 'targetSeat', 'stat', 'baseValue', 'effectiveValue'])
        && pt.bySeat is int && pt.bySeat >= 0 && pt.bySeat <= 3
        && pt.targetSeat is int && pt.targetSeat >= 0 && pt.targetSeat <= 3
        && isValidStat(pt.stat)
        && pt.baseValue is int && pt.baseValue >= 0 && pt.baseValue <= 500
        && pt.effectiveValue is int && pt.effectiveValue >= 0 && pt.effectiveValue <= 500
      );
    }

    function isValidBestWin(bw) {
      return bw == null || (
        bw is map
        && bw.keys().hasAll(['cardId', 'playerId', 'stat', 'effectiveValue', 'round'])
        && bw.keys().hasOnly(['cardId', 'playerId', 'stat', 'effectiveValue', 'round'])
        && bw.cardId is string && bw.cardId.size() >= 1 && bw.cardId.size() <= 64
        && isValidSeatId(bw.playerId)
        && isValidStat(bw.stat)
        && bw.effectiveValue is int && bw.effectiveValue >= 0 && bw.effectiveValue <= 500
        && bw.round is int && bw.round >= 1 && bw.round <= 200
      );
    }

    function isValidLastOutcome(outcome) {
      return outcome == null || (
        outcome is map
        && outcome.keys().hasAll([
          'round', 'leaderId', 'stat', 'entries', 'gambitActive',
          'resurrectedPlayers', 'winnerId', 'tiedPlayerIds', 'potWon', 'potSizeAfter'
        ])
        && outcome.keys().hasOnly([
          'round', 'leaderId', 'stat', 'entries', 'gambitActive',
          'resurrectedPlayers', 'winnerId', 'tiedPlayerIds', 'potWon', 'potSizeAfter'
        ])
        && outcome.round is int && outcome.round >= 1 && outcome.round <= 200
        && isValidSeatId(outcome.leaderId)
        && isValidStat(outcome.stat)
        && outcome.entries is list && outcome.entries.size() >= 2 && outcome.entries.size() <= 4
        && outcome.gambitActive is bool
        && outcome.resurrectedPlayers is list && outcome.resurrectedPlayers.size() <= 4
        && (outcome.winnerId in ['p1', 'p2', 'p3', 'p4', 'TIE'])
        && outcome.tiedPlayerIds is list && outcome.tiedPlayerIds.size() <= 4
        && outcome.potWon is int && outcome.potWon >= 0 && outcome.potWon <= 60
        && outcome.potSizeAfter is int && outcome.potSizeAfter >= 0 && outcome.potSizeAfter <= 60
      );
    }

    function isValidMatch(data) {
      return data.keys().hasAll([
          'matchId', 'roomCode', 'status', 'hostUid', 'maxPlayers', 'fillWithBots',
          'activePlayers', 'matchSeed', 'round', 'maxRounds', 'teamMode',
          'activeTurnIndex', 'activeRealm', 'players', 'warPot', 'gambitArmed',
          'statWins', 'winner', 'turnStartedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'matchId', 'roomCode', 'status', 'hostUid', 'maxPlayers', 'fillWithBots',
          'activePlayers', 'matchSeed', 'round', 'maxRounds', 'teamMode',
          'activeTurnIndex', 'activeRealm', 'players', 'warPot', 'gambitArmed',
          'prophecyTarget', 'statWins', 'bestWin', 'winner', 'lastOutcome',
          'turnStartedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.matchId)
        && isValidRoomCode(data.roomCode)
        && isValidStatus(data.status)
        && isValidUid(data.hostUid)
        && data.maxPlayers in [2, 3, 4]
        && data.fillWithBots is bool
        && isValidActivePlayers(data.activePlayers)
        && data.matchSeed is int && data.matchSeed >= 0 && data.matchSeed <= 4294967295
        && data.round is int && data.round >= 1 && data.round <= 200
        && data.maxRounds is int && data.maxRounds >= 1 && data.maxRounds <= 200
        && data.teamMode in ['ffa', 'teams']
        && data.activeTurnIndex is int && data.activeTurnIndex >= 0 && data.activeTurnIndex < data.players.size()
        && isValidRealm(data.activeRealm)
        && isValidPlayersList(data.players)
        && isValidDeck(data.warPot)
        && data.gambitArmed is bool
        && (!('prophecyTarget' in data) || isValidProphecyTarget(data.prophecyTarget))
        && isValidStatWins(data.statWins)
        && (!('bestWin' in data) || isValidBestWin(data.bestWin))
        && isValidWinner(data.winner)
        && (!('lastOutcome' in data) || isValidLastOutcome(data.lastOutcome))
        && data.turnStartedAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isSeatedUid(data, uid) {
      return (data.players[0].uid == uid)
        || (data.players[1].uid == uid)
        || (data.players.size() >= 3 && data.players[2].uid == uid)
        || (data.players.size() >= 4 && data.players[3].uid == uid);
    }

    function isParticipant(data) {
      return request.auth.uid == data.hostUid
        || (request.auth.uid in data.activePlayers)
        || isSeatedUid(data, request.auth.uid);
    }

    function seatJoinedOrUnchanged(i) {
      return (i >= existing().players.size())
        || (incoming().players[i] == existing().players[i])
        || (
          existing().players[i].uid == null
          && incoming().players[i].uid == request.auth.uid
          && incoming().players[i].isBot == false
          && incoming().players[i].away == false
          && incoming().players[i].ready == false
          && incoming().players[i].deck == existing().players[i].deck
        );
    }

    function seatReadyOwnOrUnchanged(i) {
      return (i >= existing().players.size())
        || (incoming().players[i] == existing().players[i])
        || (
          existing().players[i].uid == request.auth.uid
          && incoming().players[i].diff(existing().players[i]).affectedKeys().hasOnly(['ready'])
        );
    }

    function seatAwayOwnOrUnchanged(i) {
      return (i >= existing().players.size())
        || (incoming().players[i] == existing().players[i])
        || (
          existing().players[i].uid == request.auth.uid
          && incoming().players[i].diff(existing().players[i]).affectedKeys().hasOnly(['away'])
        );
    }

    function seatKickedOrUnchanged(i) {
      return (i >= existing().players.size())
        || (incoming().players[i] == existing().players[i])
        || (
          i > 0
          && existing().players[i].uid != null
          && incoming().players[i].uid == null
          && incoming().players[i].isBot == false
          && incoming().players[i].ready == false
          && incoming().players[i].away == false
        );
    }

    function isJoinRoomAction() {
      return existing().status == 'waiting'
        && !isSeatedUid(existing(), request.auth.uid)
        && isSeatedUid(incoming(), request.auth.uid)
        && (request.auth.uid in incoming().activePlayers)
        && incoming().activePlayers.hasAll(existing().activePlayers)
        && incoming().activePlayers.size() <= 4
        && incoming().players.size() == existing().players.size()
        && seatJoinedOrUnchanged(0)
        && seatJoinedOrUnchanged(1)
        && seatJoinedOrUnchanged(2)
        && seatJoinedOrUnchanged(3)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'players', 'activePlayers', 'updatedAt'
        ]);
    }

    function isRejoinActiveAction() {
      return existing().status == 'active'
        && isSeatedUid(existing(), request.auth.uid)
        && (request.auth.uid in incoming().activePlayers)
        && incoming().activePlayers.hasAll(existing().activePlayers)
        && incoming().players.size() == existing().players.size()
        && seatAwayOwnOrUnchanged(0)
        && seatAwayOwnOrUnchanged(1)
        && seatAwayOwnOrUnchanged(2)
        && seatAwayOwnOrUnchanged(3)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'players', 'activePlayers', 'updatedAt'
        ]);
    }

    function isToggleReadyAction() {
      return existing().status == 'waiting'
        && isSeatedUid(existing(), request.auth.uid)
        && incoming().players.size() == existing().players.size()
        && seatReadyOwnOrUnchanged(0)
        && seatReadyOwnOrUnchanged(1)
        && seatReadyOwnOrUnchanged(2)
        && seatReadyOwnOrUnchanged(3)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'players', 'updatedAt'
        ]);
    }

    function isHostRoomManageAction() {
      return existing().status == 'waiting'
        && request.auth.uid == existing().hostUid
        && incoming().players.size() == existing().players.size()
        && seatKickedOrUnchanged(0)
        && seatKickedOrUnchanged(1)
        && seatKickedOrUnchanged(2)
        && seatKickedOrUnchanged(3)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fillWithBots', 'teamMode', 'players', 'activePlayers', 'updatedAt'
        ]);
    }

    function isHostStartAction() {
      return existing().status == 'waiting'
        && request.auth.uid == existing().hostUid
        && incoming().status == 'active'
        && incoming().turnStartedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'maxPlayers', 'round', 'maxRounds', 'teamMode',
          'activeTurnIndex', 'activeRealm', 'players', 'warPot',
          'gambitArmed', 'prophecyTarget', 'statWins', 'bestWin',
          'winner', 'lastOutcome', 'turnStartedAt', 'updatedAt'
        ]);
    }

    function isTurnAuthorized() {
      let turnSeat = existing().players[existing().activeTurnIndex];
      return turnSeat.uid == request.auth.uid
        || (turnSeat.isBot == true && request.auth.uid == existing().hostUid)
        || turnSeat.away == true
        || request.time > existing().turnStartedAt + duration.value(20, 's');
    }

    function isGameplayAction() {
      return existing().status == 'active'
        && existing().winner == 'NONE'
        && isParticipant(existing())
        && isTurnAuthorized()
        && incoming().activePlayers == existing().activePlayers
        && incoming().maxPlayers == existing().maxPlayers
        && incoming().fillWithBots == existing().fillWithBots
        && incoming().teamMode == existing().teamMode
        && (incoming().round == existing().round || incoming().turnStartedAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'round', 'activeTurnIndex', 'activeRealm',
          'players', 'warPot', 'gambitArmed', 'prophecyTarget',
          'statWins', 'bestWin', 'winner', 'lastOutcome',
          'turnStartedAt', 'updatedAt'
        ]);
    }

    function seatLeaveOwnOrUnchanged(i) {
      return (i >= existing().players.size())
        || (incoming().players[i] == existing().players[i])
        || (
          existing().players[i].uid == request.auth.uid
          && (
            (existing().status == 'waiting' && i > 0 && incoming().players[i].uid == null && incoming().players[i].ready == false && incoming().players[i].away == false)
            || (existing().status == 'active' && incoming().players[i].diff(existing().players[i]).affectedKeys().hasOnly(['away']) && incoming().players[i].away == true)
          )
        );
    }

    function isLeaveAction() {
      return (request.auth.uid in existing().activePlayers)
        && !(request.auth.uid in incoming().activePlayers)
        && incoming().activePlayers.size() == existing().activePlayers.size() - 1
        && incoming().players.size() == existing().players.size()
        && seatLeaveOwnOrUnchanged(0)
        && seatLeaveOwnOrUnchanged(1)
        && seatLeaveOwnOrUnchanged(2)
        && seatLeaveOwnOrUnchanged(3)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'players', 'activePlayers', 'updatedAt'
        ]);
    }

    function isHostRematchAction() {
      return existing().status == 'finished'
        && request.auth.uid == existing().hostUid
        && incoming().status == 'active'
        && incoming().round == 1
        && incoming().winner == 'NONE'
        && incoming().players.size() == existing().players.size()
        && incoming().activePlayers == existing().activePlayers
        && incoming().turnStartedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'round', 'activeTurnIndex', 'activeRealm',
          'players', 'warPot', 'gambitArmed', 'prophecyTarget',
          'statWins', 'bestWin', 'winner', 'lastOutcome',
          'turnStartedAt', 'updatedAt'
        ]);
    }

    match /matches/{matchId} {
      allow get: if isSignedIn() && isValidId(matchId) && (
        existing().status == 'waiting'
        || isParticipant(existing())
      );

      allow list: if isSignedIn() && (
        resource.data.status == 'waiting'
        || resource.data.hostUid == request.auth.uid
        || (request.auth.uid in resource.data.activePlayers)
      );

      allow create: if isSignedIn()
        && isValidId(matchId)
        && isValidMatch(incoming())
        && incoming().matchId == matchId
        && incoming().hostUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(matchId)
        && isValidMatch(incoming())
        && incoming().matchId == existing().matchId
        && incoming().roomCode == existing().roomCode
        && incoming().hostUid == existing().hostUid
        && incoming().matchSeed == existing().matchSeed
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isJoinRoomAction()
          || isRejoinActiveAction()
          || isToggleReadyAction()
          || isHostRoomManageAction()
          || isHostStartAction()
          || isGameplayAction()
          || isHostRematchAction()
          || isLeaveAction()
        );

      allow delete: if isSignedIn() && isValidId(matchId) && (
        (existing().activePlayers.size() <= 1 && (request.auth.uid in existing().activePlayers))
        || (existing().status == 'waiting' && existing().hostUid == request.auth.uid)
        || (request.time > existing().createdAt + duration.value(2, 'h') && (existing().status == 'waiting' || existing().activePlayers.size() == 0))
      );
    }
  }
}