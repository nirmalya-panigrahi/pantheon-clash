# Optional Vite base path for GitHub Pages (defaults to './' for relative asset loading).
# Example for project pages: VITE_BASE_PATH="/pantheon-clash/"
VITE_BASE_PATH="./"

# Optional Firebase Web API key (kept unset in static GitHub Pages builds so no key is exposed).
# Set locally in .env.local to enable 2-Player Online Arena mode.
VITE_FIREBASE_API_KEY=""
